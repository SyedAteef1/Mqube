# Copy to .env.production on the server and fill in. Never commit the real file.
# Generate each secret with:  openssl rand -hex 32

# The web address staff will open; point its DNS A record at the server.
DOMAIN=billing.example.in
# No domain yet (demo on a bare IP address, plain HTTP)? Use:  DOMAIN=:80

# Only when the API runs on a different server than the web app:
# API_UPSTREAM=10.0.0.5:8000
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
INTERNAL_SERVICE_KEY=
SGIP_VAULT_MASTER_KEY=

# First owner login (username "admin"). 12+ characters. Change it after first sign-in if you like.
MQUBE_ADMIN_PASSWORD=
MQUBE_ADMIN_EMAIL=

BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
GUNICORN_WORKERS=2
