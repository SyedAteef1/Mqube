

# TILEFLOW Retail OS AI Intelligence Credentials
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Platform Abstraction Layer (PAL) Provider Options
DATABASE_PROVIDER=postgres
SYNC_PROVIDER=postgres
CACHE_PROVIDER=memory
STORAGE_PROVIDER=filesystem

# PostgreSQL Standalone Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tileflowsys
POSTGRES_PORT=5432

# Docker-Compose Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tileflowsys

# Local development / test environment values
# Generate a secure key per environment: openssl rand -hex 32
JWT_SECRET_KEY=

# SGIP Vault Master Key (AES-256-GCM + HKDF-SHA256 Root Key)
# MUST be generated fresh per environment (never copied from example to production): openssl rand -hex 32
# MUST NOT be the same value as JWT_SECRET_KEY
# Internal Service Key for inter-service API authorization (FastAPI <-> Node)
# Generate a secure key per environment: openssl rand -hex 32
INTERNAL_SERVICE_KEY=

# Optional Default Bank Details for Invoicing (fallback if not configured in Company Tax Profile)
DEFAULT_BANK_NAME=
DEFAULT_BANK_ACCOUNT_NO=
DEFAULT_BANK_IFSC=
DEFAULT_BANK_BRANCH=


